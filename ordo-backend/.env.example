# IBM watsonx.ai credentials
# Get these from: https://cloud.ibm.com
# 1. Sign up at cloud.ibm.com/registration
# 2. Create a watsonx.ai project -> copy the UUID from the browser URL
# 3. Manage -> IAM -> API keys -> Create -> copy the key

WATSONX_API_KEY=your-iam-api-key-here
WATSONX_PROJECT_ID=your-project-uuid-here
WATSONX_REGION=eu-gb
WATSONX_MODEL_ID=ibm/granite-4-h-small

# GitHub Personal Access Token (for API rate limits — public repos only need read access)
# Get from: https://github.com/settings/tokens -> Generate new token (classic) -> check "public_repo"
GITHUB_TOKEN=your-github-pat-here

# Server config
PORT=3001
